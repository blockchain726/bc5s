# bc.game account (the bot types these into the login form; never share this file)
BC_EMAIL=
BC_PASS=

# which model makes the calls: sign (HawkesSign) | mhh (MHH flow) | agree (both must agree)
AUTO_MODEL=sign
# the real base stake per round, in USD
AUTO_STAKE_USD=1
# real compensate ladder (stake multipliers by real losses in a row, e.g. 1,2): used ONLY while the go-live gate
# is open (the calling model's forward record beats the break-even); until then real orders stay flat
AUTO_REAL_LADDER=1
# paper ladders: stake after a loss = previous x this (1 = flat); AUTO_LADDER_MAX_USD=0 never gives up
AUTO_PROGRESSION=1

# ---- real money: nothing below arms the bot by itself; "live arm run=<n> day=<date>" does, in the terminal ----
# both must be 1 before the bot accepts an arming at all
LIVE_ALLOWED=0
# bc.game's User Agreement (2.1.13) lists automated play as prohibited; set 1 only if you accept that risk
TOS_RISK_ACCEPTED=0
# real losses in a row at which the bot stops and disarms (only a real WIN resets the count; a re-arm beyond it
# allows exactly one order)
AUTO_MAX_REAL_RUN=5
# minutes after such a stop before a re-arm is accepted
AUTO_REARM_COOLOFF_MIN=15
# an arming expires after this many hours
AUTO_ARM_TTL_H=4
# real-money loss allowed per calendar day, checked before each order
AUTO_DAILY_LOSS_USD=8
# real order attempts per calendar day (placed, rejected and unknown all count)
AUTO_MAX_REAL_BETS_DAY=60
# cumulative real loss since the first arming at which real orders are over for good
AUTO_CAMPAIGN_LOSS_USD=40
# no real order unless the balance is at least this many stakes
AUTO_MIN_BANKROLL_STAKES=20
# never click later than this before the cutoff, on bc.game's clock (never below 1.2)
AUTO_SEND_MARGIN_S=1.5
# run every real-order check on paper and log what the bot would have done (1 = on)
AUTO_SHADOW=1
# 1: a real order whose balance change does not match its result stops real orders (off by default:
# the Tap bot moves the same balance)
AUTO_BALANCE_STOP=0
# draw our price (the 6-exchange mix) as a cyan line on bc.game's own Up/Down chart
AUTO_PAGE_CURVE=1
# 1: an arming that was live when the bot stopped goes on after a restart (until its 4 h expire)
AUTO_RESUME_ARM=1
# needed for anything that arms, disarms or places orders through the HTTP API / dashboard
API_TOKEN=

# the most one manual order may be worth, in USD (big stakes dilute the pari-mutuel payout)
MAX_USD=5

# ---- Tap game (bc.game/trading/tap) ----
# off | demo (the page's demo account) | real (account money); the bot never switches it by itself
TAP_LIVE=off
# the Tap tab opens this many seconds after the Up/Down page (two game launches at once trip bc.game's limit)
TAP_START_DELAY_S=25
# per tap, in the account currency; real taps stop for good once real P&L - open stakes would pass -TAP_BUDGET_USD
TAP_STAKE=1
TAP_BUDGET_USD=30
# tap only when EV at the multiplier the server has been paying (label x server/label ratio) is at least this
TAP_MIN_EV=1.15
TAP_MAX_OPEN=2
TAP_MIN_GAP_S=6
# real taps need the server/label ratio from this many orders (demo or real) first
TAP_RATIO_MIN_N=5
# losses in a row before a pause of TAP_PAUSE_MIN minutes
TAP_LOSS_RUN_PAUSE=10
TAP_PAUSE_MIN=10
